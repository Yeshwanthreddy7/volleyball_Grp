*.mov
*.mkv

# OS junk
.DS_Store
Thumbs.db

# Reproduction outputs: regenerated by `python reproduce.py`, so committing them
# would make the repo carry stale numbers that disagree with the code. The
# committed source of truth is the script; results/latest/ is a build artefact.
results/
reproduce_full.log

# Large archives and datasets - transfer separately
*.zip
dataset/
volleyball-detection.yolov11/

# Stock detector weights - auto-download via ultralytics, no reason to bloat
# the repo. The custom fine-tune (fyp/volleyball_best.pt) is NOT excluded here -
# it is a real trained deliverable and is un-ignored in fyp/.gitignore.
/yolo11n.pt
/yolov8n.pt

# Simulated gold labels are NOT data - they exist only to exercise the Tier-2
# code path and their numbers are meaningless.
gold_SIMULATED.csv

